---
import ExperiencePortal from "../components/ExperiencePortal";
import profileData from "../data/generated_profile.json";

const title = `${profileData.cv.meta.name} — Data Scientist & Data/AI Engineer Portal`;
const description = profileData.cv.summary_es;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --bg-primary: #050814;
        --bg-secondary: #0b132b;
        --bg-card: rgba(15, 23, 42, 0.82);
        --border-subtle: rgba(51, 65, 85, 0.65);
        --accent-cyan: #06b6d4;
        --accent-sky: #38bdf8;
        --accent-emerald: #10b981;
        --text-main: #f8fafc;
        --text-muted: #94a3b8;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
        background: var(--bg-primary);
        color: var(--text-main);
        font-family: "Inter", system-ui, -apple-system, sans-serif;
      }

      body {
        min-height: 100vh;
        background:
          radial-gradient(circle at 80% 10%, rgba(6, 182, 212, 0.14), transparent 40%),
          radial-gradient(circle at 15% 80%, rgba(16, 185, 129, 0.11), transparent 40%),
          linear-gradient(180deg, #050814 0%, #091124 100%);
        line-height: 1.6;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .top-nav {
        position: sticky;
        top: 0;
        z-index: 50;
        backdrop-filter: blur(14px);
        background: rgba(5, 8, 20, 0.84);
        border-bottom: 1px solid var(--border-subtle);
      }

      .nav-inner {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0.85rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        font-weight: 800;
        font-size: 1.05rem;
        letter-spacing: 0.3px;
      }

      .brand-dot {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        background: var(--accent-emerald);
        box-shadow: 0 0 10px var(--accent-emerald);
      }

      .brand-tag {
        font-size: 0.7rem;
        padding: 0.12rem 0.45rem;
        border-radius: 6px;
        background: rgba(6, 182, 212, 0.18);
        color: #67e8f9;
        border: 1px solid rgba(6, 182, 212, 0.4);
      }

      .nav-links {
        display: flex;
        gap: 1.25rem;
        font-size: 0.9rem;
        color: var(--text-muted);
      }

      .nav-links a:hover {
        color: var(--text-main);
      }

      .nav-actions {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .lang-switch {
        display: inline-flex;
        background: #0f172a;
        border: 1px solid var(--border-subtle);
        border-radius: 8px;
        overflow: hidden;
      }

      .lang-btn {
        background: transparent;
        border: none;
        color: var(--text-muted);
        padding: 0.35rem 0.65rem;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
      }

      .lang-btn.active {
        background: var(--accent-cyan);
        color: #041019;
      }

      .btn-cv-sm {
        font-size: 0.78rem;
        font-weight: 600;
        padding: 0.38rem 0.7rem;
        border-radius: 8px;
        background: rgba(16, 185, 129, 0.16);
        color: #6ee7b7;
        border: 1px solid rgba(16, 185, 129, 0.45);
      }

      .btn-cv-sm.secondary {
        background: rgba(56, 189, 248, 0.15);
        color: #7dd3fc;
        border-color: rgba(56, 189, 248, 0.45);
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 4rem;
      }

      .hero-section {
        text-align: center;
        padding: 1.5rem 0 2.5rem;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.38rem 1rem;
        border-radius: 999px;
        background: rgba(16, 185, 129, 0.12);
        border: 1px solid rgba(16, 185, 129, 0.45);
        color: #a7f3d0;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        margin-bottom: 1.2rem;
      }

      .pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #10b981;
        box-shadow: 0 0 8px #10b981;
      }

      .hero-title {
        font-size: clamp(2.3rem, 5vw, 3.8rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        background: linear-gradient(90deg, #ffffff, #67e8f9, #34d399);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      .hero-tagline {
        font-size: clamp(1.05rem, 2.2vw, 1.35rem);
        color: var(--accent-sky);
        font-weight: 600;
        margin-top: 0.5rem;
      }

      .hero-summary {
        max-width: 860px;
        margin: 1rem auto 1.6rem;
        color: var(--text-muted);
        font-size: 0.98rem;
      }

      .hero-cta-row {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-bottom: 2rem;
      }

      .btn-primary,
      .btn-secondary,
      .btn-ghost {
        padding: 0.7rem 1.25rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: transform 0.15s ease, border-color 0.15s ease;
      }

      .btn-primary {
        background: linear-gradient(135deg, #06b6d4, #10b981);
        color: #04131a;
      }

      .btn-secondary {
        background: rgba(56, 189, 248, 0.16);
        color: #e0f2fe;
        border: 1px solid rgba(56, 189, 248, 0.45);
      }

      .btn-ghost {
        background: rgba(15, 23, 42, 0.8);
        color: #cbd5e1;
        border: 1px solid var(--border-subtle);
      }

      .btn-primary:hover,
      .btn-secondary:hover,
      .btn-ghost:hover {
        transform: translateY(-2px);
      }

      .banner-preview-wrapper {
        margin: 1.5rem auto 2rem;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid var(--border-subtle);
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.55);
      }

      .banner-svg-img {
        display: block;
        width: 100%;
        height: auto;
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-top: 1.5rem;
      }

      .stat-card {
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: 14px;
        padding: 1.2rem;
      }

      .stat-value {
        font-size: 2rem;
        font-weight: 800;
        color: #22d3ee;
      }

      .stat-label {
        font-size: 0.85rem;
        color: var(--text-muted);
      }

      .section-block {
        margin-top: 4rem;
      }

      .section-header {
        margin-bottom: 1.5rem;
      }

      .section-header h2 {
        font-size: 1.75rem;
        font-weight: 800;
      }

      .section-header p {
        color: var(--text-muted);
        font-size: 0.95rem;
        margin-top: 0.25rem;
      }

      .filter-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
      }

      .pill-btn {
        background: rgba(15, 23, 42, 0.85);
        color: #cbd5e1;
        border: 1px solid var(--border-subtle);
        padding: 0.42rem 0.85rem;
        border-radius: 999px;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.15s ease;
      }

      .pill-btn.active,
      .pill-btn:hover {
        background: rgba(6, 182, 212, 0.2);
        color: #67e8f9;
        border-color: var(--accent-cyan);
      }

      .timeline {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        border-left: 2px solid rgba(6, 182, 212, 0.35);
        padding-left: 1.5rem;
      }

      .timeline-card {
        position: relative;
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: 14px;
        padding: 1.5rem;
      }

      .timeline-card.current {
        border-color: rgba(16, 185, 129, 0.55);
        box-shadow: 0 0 25px rgba(16, 185, 129, 0.08);
      }

      .timeline-dot {
        position: absolute;
        left: -2.02rem;
        top: 1.75rem;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--accent-cyan);
        border: 3px solid var(--bg-primary);
      }

      .timeline-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        flex-wrap: wrap;
      }

      .job-role-row {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        flex-wrap: wrap;
      }

      .job-role-row h3 {
        font-size: 1.2rem;
        font-weight: 700;
      }

      .live-chip {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.15rem 0.55rem;
        border-radius: 999px;
        background: rgba(16, 185, 129, 0.18);
        color: #6ee7b7;
        border: 1px solid rgba(16, 185, 129, 0.4);
      }

      .job-company {
        color: #cbd5e1;
        font-size: 0.92rem;
        margin-top: 0.2rem;
      }

      .job-period {
        font-family: "JetBrains Mono", monospace;
        font-size: 0.82rem;
        color: #67e8f9;
        background: rgba(6, 182, 212, 0.1);
        padding: 0.25rem 0.65rem;
        border-radius: 6px;
      }

      .job-domain {
        margin-top: 0.6rem;
        font-size: 0.84rem;
        color: #34d399;
        font-weight: 600;
      }

      .job-bullets {
        margin: 0.85rem 0 1rem 1.2rem;
        color: #cbd5e1;
        font-size: 0.92rem;
      }

      .job-bullets li {
        margin-bottom: 0.4rem;
      }

      .job-tags,
      .project-tools,
      .skill-items-wrap {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
      }

      .tech-tag {
        font-size: 0.76rem;
        font-family: "JetBrains Mono", monospace;
        padding: 0.22rem 0.6rem;
        border-radius: 6px;
        background: rgba(30, 41, 59, 0.9);
        color: #bae6fd;
        border: 1px solid rgba(56, 189, 248, 0.25);
        cursor: pointer;
      }

      .tech-tag.highlighted {
        background: var(--accent-cyan);
        color: #041019;
        font-weight: 700;
      }

      .skill-search-input {
        width: 100%;
        padding: 0.75rem 1rem;
        margin-bottom: 1rem;
        border-radius: 10px;
        border: 1px solid var(--border-subtle);
        background: rgba(15, 23, 42, 0.9);
        color: var(--text-main);
        font-size: 0.95rem;
      }

      .skills-grid,
      .projects-grid,
      .repos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
        gap: 1.15rem;
      }

      .skill-domain-card,
      .project-card,
      .repo-card,
      .edu-card,
      .cert-card {
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: 14px;
        padding: 1.3rem;
      }

      .skill-domain-card h3 {
        font-size: 1.02rem;
        margin-bottom: 0.85rem;
        color: #f8fafc;
      }

      .skill-badge {
        font-size: 0.8rem;
        padding: 0.3rem 0.65rem;
        border-radius: 8px;
        background: rgba(15, 23, 42, 0.95);
        border: 1px solid rgba(148, 163, 184, 0.25);
        color: #e2e8f0;
      }

      .project-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1rem;
      }

      .project-cat {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: #34d399;
        font-weight: 700;
      }

      .project-card h3 {
        font-size: 1.1rem;
        margin: 0.3rem 0 0.5rem;
      }

      .project-card p {
        font-size: 0.88rem;
        color: var(--text-muted);
      }

      .project-link {
        display: inline-block;
        margin-top: 0.85rem;
        font-size: 0.84rem;
        font-weight: 600;
        color: #38bdf8;
      }

      .repo-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: border-color 0.15s ease, transform 0.15s ease;
      }

      .repo-card:hover {
        border-color: var(--accent-cyan);
        transform: translateY(-2px);
      }

      .repo-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
      }

      .repo-name {
        font-weight: 700;
        color: #f8fafc;
      }

      .repo-lang {
        font-size: 0.74rem;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        background: rgba(6, 182, 212, 0.15);
        color: #67e8f9;
      }

      .repo-desc {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 0.9rem;
      }

      .repo-foot {
        display: flex;
        justify-content: space-between;
        font-size: 0.76rem;
        color: #64748b;
      }

      .edu-certs-layout {
        display: grid;
        grid-template-columns: 1fr 1.6fr;
        gap: 1.5rem;
      }

      @media (max-width: 860px) {
        .edu-certs-layout {
          grid-template-columns: 1fr;
        }
      }

      .edu-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 1rem;
      }

      .edu-period {
        font-size: 0.75rem;
        color: #38bdf8;
        font-weight: 700;
      }

      .certs-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
      }

      .platzi-link {
        font-size: 0.85rem;
        color: #34d399;
        font-weight: 600;
      }

      .certs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 0.75rem;
      }

      .cert-card {
        padding: 0.9rem 1rem;
      }

      .cert-name {
        font-size: 0.88rem;
        font-weight: 600;
      }

      .cert-meta {
        font-size: 0.76rem;
        color: var(--text-muted);
        margin-top: 0.25rem;
      }

      .portal-footer {
        border-top: 1px solid var(--border-subtle);
        text-align: center;
        padding: 2rem 1rem;
        font-size: 0.85rem;
        color: var(--text-muted);
      }
    </style>
  </head>
  <body>
    <ExperiencePortal client:load profileData={profileData} baseUrl={baseUrl} />
  </body>
</html>
