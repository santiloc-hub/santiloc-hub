---
import ExperiencePortal from "../components/ExperiencePortal";
import profileData from "../data/generated_profile.json";

const title = `${profileData.cv.meta.name} — Data Scientist & AI Engineer`;
const description = profileData.cv.summary_es;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        /* Exact Jake Sinclair (jakesinclair.ca) Color Tokens */
        --token-obsidian: #0f0e0e;
        --token-surface: #191919;
        --token-surface-elevated: #212020;
        --token-gold: #ffd98e;
        --token-offwhite: #fcfcfc;
        --token-warmgray: #999999;
        --token-muted: #7c7c7c;
        --token-border: rgba(252, 252, 252, 0.08);
        --token-border-gold: rgba(255, 217, 142, 0.35);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
        background-color: var(--token-obsidian);
        color: var(--token-offwhite);
        font-family: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      body {
        min-height: 100vh;
        background-color: var(--token-obsidian);
        color: var(--token-offwhite);
        overflow-x: hidden;
        line-height: 1.6;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .js-shell {
        position: relative;
        min-height: 100vh;
      }

      .warm-spotlight {
        position: fixed;
        top: -220px;
        left: 50%;
        transform: translateX(-50%);
        width: 920px;
        height: 460px;
        pointer-events: none;
        z-index: 0;
        background: radial-gradient(
          ellipse at center,
          rgba(255, 217, 142, 0.09) 0%,
          rgba(255, 217, 142, 0.02) 45%,
          transparent 75%
        );
        filter: blur(60px);
      }

      /* Framer-style Word-by-Word Blur Reveal Animation */
      @keyframes framerBlurReveal {
        0% {
          opacity: 0.001;
          filter: blur(10px);
          transform: translateY(10px);
        }
        100% {
          opacity: 1;
          filter: blur(0px);
          transform: translateY(0px);
        }
      }

      .blur-word {
        display: inline-block;
        opacity: 0.001;
        animation: framerBlurReveal 0.65s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      /* TOP HUD HEADER (Jake Sinclair style) */
      .hud-header {
        position: sticky;
        top: 0;
        z-index: 80;
        backdrop-filter: blur(16px);
        background: rgba(15, 14, 14, 0.82);
        border-bottom: 1px solid var(--token-border);
      }

      .hud-inner {
        max-width: 1320px;
        margin: 0 auto;
        padding: 0.9rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }

      .hud-left {
        display: flex;
        align-items: center;
        gap: 1.25rem;
      }

      .hud-brand {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        font-family: "Plus Jakarta Sans", sans-serif;
        font-weight: 700;
        font-size: 0.92rem;
        color: var(--token-offwhite);
        letter-spacing: -0.02em;
      }

      .hud-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--token-gold);
        box-shadow: 0 0 10px rgba(255, 217, 142, 0.65);
      }

      .hud-clock {
        font-family: "JetBrains Mono", monospace;
        font-size: 0.74rem;
        color: var(--token-muted);
        padding-left: 1.25rem;
        border-left: 1px solid var(--token-border);
      }

      @media (max-width: 820px) {
        .hud-clock {
          display: none;
        }
      }

      .hud-nav {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        background: var(--token-surface);
        border: 1px solid var(--token-border);
        padding: 0.25rem;
        border-radius: 999px;
      }

      .hud-nav a {
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--token-warmgray);
        padding: 0.36rem 0.9rem;
        border-radius: 999px;
        transition: all 0.2s ease;
      }

      .hud-nav a:hover {
        color: var(--token-offwhite);
        background: rgba(252, 252, 252, 0.06);
      }

      .hud-right {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .hud-lang-toggle {
        display: inline-flex;
        background: var(--token-surface);
        border: 1px solid var(--token-border);
        padding: 2px;
        border-radius: 999px;
      }

      .hud-lang-btn {
        background: transparent;
        border: none;
        color: var(--token-muted);
        font-size: 0.74rem;
        font-weight: 600;
        padding: 0.28rem 0.65rem;
        border-radius: 999px;
        cursor: pointer;
        transition: all 0.15s ease;
      }

      .hud-lang-btn.active {
        background: var(--token-gold);
        color: var(--token-obsidian);
      }

      .hud-cv-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: var(--token-surface);
        color: var(--token-gold);
        border: 1px solid var(--token-border-gold);
        padding: 0.38rem 0.85rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .hud-cv-btn:hover {
        background: var(--token-gold);
        color: var(--token-obsidian);
      }

      /* MAIN CONTAINER */
      .editorial-main {
        position: relative;
        z-index: 1;
        max-width: 1320px;
        margin: 0 auto;
        padding: 4.5rem 2rem 6rem;
      }

      /* EDITORIAL HERO */
      .js-hero {
        max-width: 1080px;
        padding-bottom: 4.5rem;
        border-bottom: 1px solid var(--token-border);
      }

      .hero-avatar-row {
        display: flex;
        align-items: center;
        gap: 1.35rem;
        margin-bottom: 2rem;
      }

      .squircle-avatar {
        position: relative;
        width: 88px;
        height: 88px;
        border-radius: 22px;
        background: linear-gradient(145deg, #22201e, #141313);
        border: 1px solid var(--token-border-gold);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.55);
      }

      .squircle-initials {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: 1.75rem;
        font-weight: 800;
        color: var(--token-gold);
        letter-spacing: -0.03em;
      }

      .squircle-status-dot {
        position: absolute;
        bottom: -3px;
        right: -3px;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: #22c55e;
        border: 3px solid var(--token-obsidian);
      }

      .hero-gold-name {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: clamp(1.55rem, 2.5vw, 2.1rem);
        font-weight: 700;
        color: var(--token-gold);
        letter-spacing: -0.03em;
        line-height: 1.15;
      }

      .hero-role-caption {
        font-size: 0.92rem;
        color: var(--token-warmgray);
        margin-top: 0.25rem;
      }

      .hero-statement {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: clamp(2.25rem, 4.6vw, 4rem);
        font-weight: 700;
        color: var(--token-offwhite);
        line-height: 1.1;
        letter-spacing: -0.038em;
        margin-bottom: 1.5rem;
      }

      .hero-sublead {
        font-size: 1.05rem;
        color: var(--token-warmgray);
        max-width: 820px;
        line-height: 1.7;
      }

      .hero-actions-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 2.25rem;
      }

      .btn-gold {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        background: var(--token-gold);
        color: var(--token-obsidian);
        font-weight: 600;
        font-size: 0.88rem;
        padding: 0.78rem 1.4rem;
        border-radius: 999px;
        border: 1px solid var(--token-gold);
        cursor: pointer;
        transition: transform 0.2s ease, opacity 0.2s ease;
      }

      .btn-gold:hover {
        transform: translateY(-2px);
        opacity: 0.94;
      }

      .btn-obsidian {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--token-surface);
        color: var(--token-offwhite);
        font-weight: 500;
        font-size: 0.88rem;
        padding: 0.78rem 1.35rem;
        border-radius: 999px;
        border: 1px solid var(--token-border);
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .btn-obsidian:hover {
        border-color: var(--token-border-gold);
        color: var(--token-gold);
        transform: translateY(-2px);
      }

      .js-metrics-row {
        margin-top: 3.25rem;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
        padding-top: 2.25rem;
        border-top: 1px solid var(--token-border);
      }

      @media (max-width: 780px) {
        .js-metrics-row {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      .js-metric-item {
        display: flex;
        flex-direction: column;
      }

      .js-metric-val {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: 2.2rem;
        font-weight: 700;
        color: var(--token-gold);
        letter-spacing: -0.03em;
        line-height: 1.1;
      }

      .js-metric-lbl {
        font-size: 0.84rem;
        color: var(--token-warmgray);
        margin-top: 0.3rem;
      }

      /* SECTIONS */
      .js-section {
        padding-top: 5.5rem;
      }

      .js-section-head {
        margin-bottom: 2.5rem;
      }

      .js-eyebrow {
        display: inline-block;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        color: var(--token-gold);
        margin-bottom: 0.6rem;
      }

      .js-section-title {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: clamp(1.75rem, 3.2vw, 2.6rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        color: var(--token-offwhite);
        max-width: 780px;
        line-height: 1.18;
      }

      /* SELECTED WORK — LARGE FORMAT CARDS */
      .work-showcase-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.75rem;
      }

      @media (max-width: 920px) {
        .work-showcase-grid {
          grid-template-columns: 1fr;
        }
      }

      .work-showcase-card {
        background: var(--token-surface);
        border: 1px solid var(--token-border);
        border-radius: 22px;
        overflow: hidden;
        transition: border-color 0.25s ease, transform 0.25s ease;
      }

      .work-showcase-card:hover {
        border-color: var(--token-border-gold);
        transform: translateY(-4px);
      }

      .work-card-link {
        display: flex;
        flex-direction: column;
        height: 100%;
      }

      .work-visual-canvas {
        position: relative;
        height: 230px;
        padding: 1.35rem 1.5rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border-bottom: 1px solid var(--token-border);
        overflow: hidden;
      }

      .canvas-top-row,
      .canvas-bottom-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.68rem;
      }

      .canvas-spec-label {
        color: var(--token-gold);
        letter-spacing: 0.1em;
      }

      .canvas-index {
        color: var(--token-muted);
      }

      .canvas-diagram {
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .work-showcase-card:hover .canvas-diagram {
        transform: scale(1.04);
      }

      .canvas-svg {
        width: 100%;
        max-width: 390px;
        height: 105px;
      }

      .canvas-metric {
        color: var(--token-warmgray);
      }

      .canvas-cat-pill {
        color: var(--token-offwhite);
        background: rgba(252, 252, 252, 0.06);
        padding: 0.18rem 0.55rem;
        border-radius: 999px;
      }

      .work-card-body {
        padding: 1.65rem;
        display: flex;
        flex-direction: column;
        flex: 1;
      }

      .work-meta-line {
        display: flex;
        justify-content: space-between;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.74rem;
        color: var(--token-muted);
        margin-bottom: 0.65rem;
      }

      .work-category {
        color: var(--token-gold);
      }

      .work-title-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 0.65rem;
      }

      .work-title-row h3 {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: 1.32rem;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--token-offwhite);
      }

      .work-arrow-circle {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 1px solid var(--token-border);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        color: var(--token-warmgray);
        flex-shrink: 0;
        transition: all 0.2s ease;
      }

      .work-showcase-card:hover .work-arrow-circle {
        background: var(--token-gold);
        color: var(--token-obsidian);
        border-color: var(--token-gold);
      }

      .work-description {
        font-size: 0.92rem;
        color: var(--token-warmgray);
        margin-bottom: 1.35rem;
        flex: 1;
      }

      .work-tags,
      .cap-tags,
      .exp-tags-wrap,
      .stack-items {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
      }

      .work-tag-pill {
        font-family: "JetBrains Mono", monospace;
        font-size: 0.72rem;
        padding: 0.28rem 0.7rem;
        border-radius: 999px;
        background: var(--token-obsidian);
        color: var(--token-warmgray);
        border: 1px solid var(--token-border);
      }

      .work-tag-pill.clickable {
        cursor: pointer;
      }

      .work-tag-pill.active,
      .work-tag-pill.clickable:hover {
        border-color: var(--token-gold);
        color: var(--token-gold);
      }

      /* 6-PILLAR CAPABILITIES GRID (Jake Sinclair Signature Section) */
      .capabilities-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.35rem;
      }

      @media (max-width: 1024px) {
        .capabilities-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 680px) {
        .capabilities-grid {
          grid-template-columns: 1fr;
        }
      }

      .capability-card {
        background: var(--token-surface);
        border: 1px solid var(--token-border);
        border-radius: 20px;
        padding: 1.85rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1.5rem;
        transition: border-color 0.2s ease;
      }

      .capability-card:hover {
        border-color: var(--token-border-gold);
      }

      .cap-number {
        display: inline-block;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--token-gold);
        margin-bottom: 0.85rem;
      }

      .cap-title {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: 1.25rem;
        font-weight: 700;
        color: var(--token-offwhite);
        letter-spacing: -0.02em;
        margin-bottom: 0.75rem;
      }

      .cap-desc {
        font-size: 0.92rem;
        color: var(--token-warmgray);
        line-height: 1.65;
      }

      .cap-tag {
        font-family: "JetBrains Mono", monospace;
        font-size: 0.7rem;
        color: var(--token-offwhite);
        background: rgba(252, 252, 252, 0.05);
        padding: 0.24rem 0.6rem;
        border-radius: 6px;
      }

      /* FILTER BAR */
      .js-filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-bottom: 2rem;
      }

      .js-filter-pill {
        background: var(--token-surface);
        color: var(--token-warmgray);
        border: 1px solid var(--token-border);
        padding: 0.42rem 0.95rem;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.15s ease;
      }

      .js-filter-pill.active,
      .js-filter-pill:hover {
        background: var(--token-gold);
        color: var(--token-obsidian);
        border-color: var(--token-gold);
        font-weight: 600;
      }

      /* EDITORIAL EXPERIENCE LEDGER */
      .exp-ledger {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      .exp-row {
        display: grid;
        grid-template-columns: 290px 1fr;
        gap: 2.5rem;
        background: var(--token-surface);
        border: 1px solid var(--token-border);
        border-radius: 22px;
        padding: 2.1rem;
      }

      .exp-row.current {
        border-color: var(--token-border-gold);
      }

      @media (max-width: 860px) {
        .exp-row {
          grid-template-columns: 1fr;
          gap: 1rem;
        }
      }

      .exp-period {
        font-family: "JetBrains Mono", monospace;
        font-size: 0.82rem;
        color: var(--token-gold);
        margin-bottom: 0.4rem;
      }

      .exp-company-name {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-weight: 700;
        font-size: 1.05rem;
        color: var(--token-offwhite);
      }

      .exp-loc {
        font-size: 0.84rem;
        color: var(--token-muted);
        margin-top: 0.2rem;
      }

      .exp-live-badge {
        display: inline-block;
        margin-top: 0.85rem;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.68rem;
        color: var(--token-gold);
        background: rgba(255, 217, 142, 0.1);
        border: 1px solid var(--token-border-gold);
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
      }

      .exp-role-heading {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--token-offwhite);
        letter-spacing: -0.02em;
      }

      .exp-domain-sub {
        font-size: 0.86rem;
        color: var(--token-gold);
        margin-top: 0.25rem;
        margin-bottom: 1rem;
      }

      .exp-bullets {
        margin-left: 1.15rem;
        margin-bottom: 1.35rem;
        color: var(--token-warmgray);
        font-size: 0.94rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      /* STACK MATRIX */
      .js-search-input {
        width: 100%;
        background: var(--token-surface);
        border: 1px solid var(--token-border);
        color: var(--token-offwhite);
        padding: 0.85rem 1.2rem;
        border-radius: 14px;
        font-size: 0.92rem;
        margin-bottom: 1rem;
        outline: none;
      }

      .js-search-input:focus {
        border-color: var(--token-border-gold);
      }

      .stack-bento-grid,
      .github-live-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.2rem;
      }

      .stack-bento-card,
      .github-live-card,
      .degree-card,
      .cert-item-card {
        background: var(--token-surface);
        border: 1px solid var(--token-border);
        border-radius: 18px;
        padding: 1.5rem;
      }

      .stack-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
      }

      .stack-card-header h3 {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: 1.02rem;
        font-weight: 700;
        color: var(--token-gold);
      }

      .stack-card-header span {
        font-family: "JetBrains Mono", monospace;
        font-size: 0.74rem;
        color: var(--token-muted);
      }

      .stack-chip {
        font-size: 0.82rem;
        padding: 0.32rem 0.75rem;
        border-radius: 8px;
        background: var(--token-obsidian);
        border: 1px solid var(--token-border);
        color: var(--token-offwhite);
      }

      /* GITHUB LIVE */
      .github-live-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1.25rem;
        transition: border-color 0.2s ease, transform 0.2s ease;
      }

      .github-live-card:hover {
        border-color: var(--token-border-gold);
        transform: translateY(-3px);
      }

      .gh-name-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.45rem;
      }

      .gh-repo-name {
        font-family: "JetBrains Mono", monospace;
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--token-offwhite);
      }

      .gh-arrow {
        color: var(--token-gold);
      }

      .gh-repo-desc {
        font-size: 0.86rem;
        color: var(--token-warmgray);
      }

      .gh-card-bottom {
        display: flex;
        justify-content: space-between;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.74rem;
        color: var(--token-muted);
      }

      .gh-lang {
        color: var(--token-gold);
      }

      /* CREDENTIALS */
      .credentials-layout {
        display: grid;
        grid-template-columns: 1fr 1.6fr;
        gap: 1.5rem;
      }

      @media (max-width: 900px) {
        .credentials-layout {
          grid-template-columns: 1fr;
        }
      }

      .degrees-col {
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .degree-badge {
        font-family: "JetBrains Mono", monospace;
        font-size: 0.72rem;
        color: var(--token-gold);
      }

      .degree-card h3 {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: 1.15rem;
        margin: 0.35rem 0;
      }

      .degree-card p {
        font-size: 0.88rem;
        color: var(--token-warmgray);
      }

      .certs-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
        font-size: 0.88rem;
        color: var(--token-warmgray);
      }

      .platzi-gold-link {
        color: var(--token-gold);
        font-weight: 600;
      }

      .certs-list-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 0.75rem;
      }

      .cert-item-card {
        padding: 1rem 1.15rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 0.35rem;
      }

      .cert-title {
        font-size: 0.86rem;
        font-weight: 600;
        color: var(--token-offwhite);
      }

      .cert-date {
        font-family: "JetBrains Mono", monospace;
        font-size: 0.72rem;
        color: var(--token-muted);
      }

      /* CLOSING CTA */
      .js-closing-cta {
        margin-top: 6rem;
        background: linear-gradient(145deg, #1b1917 0%, #131212 100%);
        border: 1px solid var(--token-border-gold);
        border-radius: 26px;
        padding: 3.5rem 2.5rem;
        text-align: center;
      }

      .js-closing-cta h2 {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-size: clamp(1.7rem, 3.2vw, 2.5rem);
        max-width: 760px;
        margin: 0.5rem auto 2rem;
        letter-spacing: -0.03em;
        line-height: 1.18;
      }

      .closing-links {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.85rem;
      }

      /* MODAL */
      .cv-modal-backdrop {
        position: fixed;
        inset: 0;
        z-index: 120;
        background: rgba(10, 9, 9, 0.86);
        backdrop-filter: blur(12px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.25rem;
      }

      .cv-modal-window {
        width: min(1020px, 96vw);
        height: 88vh;
        background: var(--token-surface);
        border: 1px solid var(--token-border-gold);
        border-radius: 18px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      .cv-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.9rem 1.35rem;
        border-bottom: 1px solid var(--token-border);
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .cv-modal-title {
        font-family: "Plus Jakarta Sans", sans-serif;
        font-weight: 700;
        color: var(--token-gold);
      }

      .cv-modal-actions {
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .btn-gold-sm {
        background: var(--token-gold);
        color: var(--token-obsidian);
        font-size: 0.76rem;
        font-weight: 600;
        padding: 0.35rem 0.8rem;
        border-radius: 999px;
      }

      .btn-close-modal {
        background: transparent;
        color: var(--token-warmgray);
        border: 1px solid var(--token-border);
        padding: 0.35rem 0.75rem;
        border-radius: 999px;
        font-size: 0.76rem;
        cursor: pointer;
      }

      .cv-modal-iframe {
        flex: 1;
        width: 100%;
        border: none;
        background: #ffffff;
      }

      /* FOOTER */
      .js-footer {
        border-top: 1px solid var(--token-border);
        padding: 2rem;
      }

      .js-footer-inner {
        max-width: 1320px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        font-family: "JetBrains Mono", monospace;
        font-size: 0.76rem;
        color: var(--token-muted);
      }
    </style>
  </head>
  <body>
    <ExperiencePortal client:load profileData={profileData} baseUrl={baseUrl} />
  </body>
</html>
